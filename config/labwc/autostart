#!/bin/sh
# Phase 1 stand-ins. A failing panel must not block login.
waybar >/dev/null 2>&1 &
wl-paste --watch cliphist store >/dev/null 2>&1 &
swayidle -w \
    timeout 300 'swaylock -f -c 000000' \
    timeout 600 'wlopm --off *' \
    resume 'wlopm --on *' \
    before-sleep 'swaylock -f -c 000000' >/dev/null 2>&1 &
