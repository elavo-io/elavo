#!/usr/bin/python3
"""Print a labwc pipemenu of installed applications."""

import configparser
import os
import xml.sax.saxutils
from pathlib import Path

DIRS = (
    Path("/usr/share/applications"),
    Path("/var/lib/flatpak/exports/share/applications"),
    Path.home() / ".local/share/applications",
)
FIELD_CODES = ("%f", "%F", "%u", "%U", "%d", "%D", "%n", "%N", "%i", "%c", "%k", "%v", "%m")


def unescape(value: str) -> str:
    return value.replace(r"\s", " ").replace(r"\n", " ").replace(r"\t", " ").replace(r"\r", " ").replace(r"\\", "\\")


def desktop_entries():
    seen = set()
    for directory in DIRS:
        if not directory.is_dir():
            continue
        for path in sorted(directory.glob("*.desktop")):
            parser = configparser.ConfigParser(interpolation=None, strict=False)
            try:
                parser.read(path, encoding="utf-8")
            except (OSError, configparser.Error):
                continue
            if "Desktop Entry" not in parser:
                continue
            entry = parser["Desktop Entry"]
            if entry.get("Type", "Application") != "Application":
                continue
            if entry.get("NoDisplay", "false").lower() == "true":
                continue
            if entry.get("Hidden", "false").lower() == "true":
                continue
            name = unescape(entry.get("Name", "")).strip()
            command = unescape(entry.get("Exec", "")).strip()
            if not name or not command or name in seen:
                continue
            for code in FIELD_CODES:
                command = command.replace(code, "")
            command = " ".join(command.split())
            seen.add(name)
            yield name, command


def main():
    print("<openbox_pipe_menu>")
    for name, command in desktop_entries():
        label = xml.sax.saxutils.escape(name)
        cmd = xml.sax.saxutils.escape(command)
        print(f'  <item label="{label}">')
        print(f'    <action name="Execute" command="{cmd}" />')
        print("  </item>")
    print("</openbox_pipe_menu>")


if __name__ == "__main__":
    main()
