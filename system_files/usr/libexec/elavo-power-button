#!/usr/bin/env python3
"""Power button.

A short press while the display is on and the session is unlocked asks the
panel to lock the screen, the same Lock Screen action as the sun menu and
Super+Ctrl+Q. On the lock screen, with the display on, it asks the panel
to sleep, the same Sleep action as the sun menu. When the display is off,
or the machine has just woken, it turns the display on and leaves the
session locked or unlocked as it was.

Super+Shift+Q asks whether to log out through elavo-panel-action as well.
Holding the button for several seconds is the firmware's power-off and
cannot be changed here.

The press arrives on the ACPI node named Power Button, or, on some
machines, on Intel HID 5 button array. That Intel node also carries the
volume keys. It is a power switch, so the compositor never sees those
keys; this service changes the volume. A keyboard's volume keys are
separate and are bound in labwc to `elavo-power-button --volume`. A
second power key that arrives immediately after the first is the same
press reported twice.
"""

import glob
import os
import select
import struct
import subprocess
import sys
import time

# The press that woke the machine arrives just after resume.
RESUME_GRACE_S = 2.0
KEY_MUTE = 113
KEY_VOLUMEDOWN = 114
KEY_VOLUMEUP = 115
KEY_POWER = 116
EV_KEY = 0x01
SINK = "@DEFAULT_AUDIO_SINK@"
EVENT = struct.Struct("llHHi")
PANEL_ACTION = os.environ.get("ELAVO_PANEL_ACTION", "/usr/libexec/elavo-panel-action")
# Intel HID events also advertises KEY_POWER on some machines and is not
# where the button press arrives. Matching it would add a second reader.
POWER_BUTTON_NAMES = ("Power Button", "Intel HID 5 button array")
# One physical press can be reported by the ACPI node and the Intel node.
SAME_PRESS_S = 0.3


def decide(screen_on, locked, resume_grace):
    """What a short press does. State is at key down."""
    if resume_grace or not screen_on:
        return "wake"
    if locked:
        return "sleep"
    return "lock"


def parse_sleep(line):
    """logind PrepareForSleep: True is going to sleep, False is waking."""
    marker = "PrepareForSleep"
    if marker not in line:
        return None
    tail = line.split(marker, 1)[1]
    if "false" in tail:
        return False
    if "true" in tail:
        return True
    return None


def key_actions(blob):
    """Actions in one read. Power and mute count the press. Volume also repeats."""
    actions = []
    while len(blob) >= EVENT.size:
        _sec, _usec, typ, code, value = EVENT.unpack_from(blob)
        blob = blob[EVENT.size :]
        if typ != EV_KEY:
            continue
        if code == KEY_POWER and value == 1:
            actions.append("power")
        elif code == KEY_VOLUMEUP and value in (1, 2):
            actions.append("up")
        elif code == KEY_VOLUMEDOWN and value in (1, 2):
            actions.append("down")
        elif code == KEY_MUTE and value == 1:
            actions.append("mute")
    return actions


def volume_commands(action):
    """wpctl argv lists for one volume-key action. Empty when unknown."""
    if action == "up":
        return [
            ["wpctl", "set-mute", SINK, "0"],
            ["wpctl", "set-volume", "-l", "1.0", SINK, "5%+"],
        ]
    if action == "down":
        return [["wpctl", "set-volume", "-l", "1.0", SINK, "5%-"]]
    if action == "mute":
        return [["wpctl", "set-mute", SINK, "toggle"]]
    return []


def apply_volume(action):
    for argv in volume_commands(action):
        subprocess.run(argv, capture_output=True)


def self_test():
    assert decide(True, False, False) == "lock"
    assert decide(True, True, False) == "sleep"
    assert decide(False, False, False) == "wake"
    assert decide(False, True, False) == "wake"
    assert decide(True, False, True) == "wake"
    assert decide(True, True, True) == "wake"
    assert decide(False, True, True) == "wake"
    def values(code):
        found = []
        stack = list(code.co_consts)
        while stack:
            item = stack.pop()
            if isinstance(item, tuple):
                stack.extend(item)
            else:
                found.append(item)
        return found

    wake = values(wake_screen.__code__)
    asleep = values(suspend.__code__)
    lock = values(lock_screen.__code__)
    assert "--on" in wake and "--off" not in wake
    assert "PANEL_ACTION" not in wake_screen.__code__.co_names
    assert "sleep" in asleep and "--off" not in asleep and "--on" not in asleep
    assert "shut-down" not in asleep
    assert "PANEL_ACTION" in suspend.__code__.co_names
    assert "lock" in lock and "shut-down" not in lock
    assert "--on" not in lock and "--off" not in lock
    assert "PANEL_ACTION" in lock_screen.__code__.co_names
    for name in ("wake_screen", "lock_screen", "suspend"):
        assert name in run.__code__.co_names
    assert "display_off" not in run.__code__.co_names
    # swayidle's argv names the lock command it has not run. That line is
    # not the lock screen; matching it blanks an unlocked desktop.
    idle = (
        '2585 swayidle -w lock elavo-greeter --lock before-sleep '
        'elavo-greeter --lock timeout 600 wlopm --off "*" resume wlopm --on "*"'
    )
    assert pgrep_lock_screen(idle) is False
    assert pgrep_lock_screen("3001 elavo-greeter --lock") is True
    assert pgrep_lock_screen("3001 /usr/bin/elavo-greeter --lock") is True
    assert pgrep_lock_screen("3001 elavo-greeter") is False
    assert pgrep_lock_screen("") is False
    detected = values(session_locked.__code__)
    assert "-x" in detected and "elavo-greeter" in detected
    assert "-f" not in detected
    assert parse_sleep("PrepareForSleep (true)") is True
    assert parse_sleep("PrepareForSleep (false)") is False
    assert parse_sleep("Monitoring signals") is None
    press = EVENT.pack(0, 0, EV_KEY, KEY_POWER, 1)
    release = EVENT.pack(0, 0, EV_KEY, KEY_POWER, 0)
    volume_up = EVENT.pack(0, 0, EV_KEY, KEY_VOLUMEUP, 1)
    volume_repeat = EVENT.pack(0, 0, EV_KEY, KEY_VOLUMEUP, 2)
    volume_down = EVENT.pack(0, 0, EV_KEY, KEY_VOLUMEDOWN, 1)
    mute = EVENT.pack(0, 0, EV_KEY, KEY_MUTE, 1)
    mute_up = EVENT.pack(0, 0, EV_KEY, KEY_MUTE, 0)
    assert key_actions(press + release) == ["power"]
    assert key_actions(release) == []
    assert key_actions(volume_up + volume_down) == ["up", "down"]
    assert key_actions(volume_repeat) == ["up"]
    assert key_actions(volume_up + press + volume_down) == ["up", "power", "down"]
    assert key_actions(mute + mute_up) == ["mute"]
    assert volume_commands("up")[0][:3] == ["wpctl", "set-mute", SINK]
    assert volume_commands("up")[1][-1] == "5%+"
    assert volume_commands("down")[0][-1] == "5%-"
    assert volume_commands("mute")[0][-1] == "toggle"
    assert volume_commands("nope") == []
    assert "up" in main.__code__.co_consts or "--volume" in main.__code__.co_consts
    assert EVENT.size == 24
    assert "Power Button" in POWER_BUTTON_NAMES
    assert "Intel HID 5 button array" in POWER_BUTTON_NAMES
    assert "Intel HID events" not in POWER_BUTTON_NAMES
    assert accept_press(10.0, None)
    assert accept_press(10.1, 10.0) is False
    assert accept_press(10.0 + SAME_PRESS_S, 10.0)
    print("self-test ok")


def log(message):
    print(f"elavo-power-button: {message}", flush=True)


def session_id():
    user = os.environ.get("USER") or "elavo"
    result = subprocess.run(
        ["loginctl", "show-user", user, "-p", "Display", "--value"],
        capture_output=True,
        text=True,
    )
    return result.stdout.strip()


def screen_on():
    result = subprocess.run(["wlopm"], capture_output=True, text=True)
    lines = [line.split() for line in result.stdout.splitlines() if line.split()]
    if not lines:
        return True
    return any(len(parts) >= 2 and parts[-1] == "on" for parts in lines)


def pgrep_lock_screen(text):
    """True when pgrep -a output is the lock-screen process.

    The idle daemon's command line contains `elavo-greeter --lock` as the
    command it will run later. That is not a running lock screen.
    """
    for line in text.splitlines():
        parts = line.split()
        if len(parts) < 2 or not parts[0].isdigit():
            continue
        program = parts[1].rsplit("/", 1)[-1]
        if program == "elavo-greeter" and "--lock" in parts[2:]:
            return True
    return False


def session_locked():
    sid = session_id()
    if sid:
        result = subprocess.run(
            ["loginctl", "show-session", sid, "-p", "LockedHint", "--value"],
            capture_output=True,
            text=True,
        )
        if result.stdout.strip() == "yes":
            return True
    # The lock screen sets the hint once it holds the lock. Match its
    # process name, not every command line that mentions the greeter.
    result = subprocess.run(
        ["pgrep", "-a", "-u", str(os.getuid()), "-x", "elavo-greeter"],
        capture_output=True,
        text=True,
    )
    return pgrep_lock_screen(result.stdout)


def wake_screen():
    subprocess.run(["wlopm", "--on", "*"], capture_output=True)


def suspend():
    """The panel's Sleep action: logind Suspend, the same one as the sun menu.

    swayidle's before-sleep still runs the greeter lock and waits until that
    command returns. A lock that is already up is left as it is.
    """
    log("sleep")
    result = subprocess.run(
        [PANEL_ACTION, "sleep"],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip()
        log(detail or "the panel did not suspend")


def lock_screen():
    """The panel's Lock Screen action, the same one Super+Ctrl+Q runs."""
    log("lock")
    result = subprocess.run(
        [PANEL_ACTION, "lock"],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip()
        log(detail or "the panel did not lock the screen")


def _ioctl(fd, number, size, buf):
    import fcntl

    request = 2 << 30 | size << 16 | ord("E") << 8 | number
    fcntl.ioctl(fd, request, buf)


def device_name(fd):
    buf = bytearray(256)
    _ioctl(fd, 0x06, len(buf), buf)
    return buf.split(b"\x00", 1)[0].decode(errors="replace")


def has_power_key(fd):
    nbytes = (KEY_POWER // 8) + 1
    buf = bytearray(nbytes)
    _ioctl(fd, 0x20 + EV_KEY, nbytes, buf)
    return bool(buf[KEY_POWER // 8] & (1 << (KEY_POWER % 8)))


def accept_press(now, last):
    """False when this power key is the same press reported again."""
    return last is None or now - last >= SAME_PRESS_S


def power_button_paths():
    """Event nodes whose sysfs name is one this service watches.

    The name is readable without opening the device. Other event nodes stay
    closed, including ones the session itself is not allowed to read.
    """
    found = []
    for path in sorted(glob.glob("/sys/class/input/event*/device/name")):
        try:
            name = open(path).read().strip()
        except OSError:
            continue
        if name not in POWER_BUTTON_NAMES:
            continue
        event = path.removeprefix("/sys/class/input/").split("/", 1)[0]
        found.append(f"/dev/input/{event}")
    return found


def open_power_buttons(already):
    """Power-button event devices not already open. Other devices are left alone."""
    opened = []
    denied = False
    for path in power_button_paths():
        if path in already:
            continue
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        except PermissionError:
            denied = True
            continue
        except OSError:
            continue
        try:
            if device_name(fd) in POWER_BUTTON_NAMES and has_power_key(fd):
                opened.append((path, fd))
                continue
        except OSError:
            pass
        os.close(fd)
    return opened, denied


class SleepWatch:
    """logind's PrepareForSleep signal, as lines from gdbus."""

    def __init__(self):
        self.proc = None
        self.fd = None
        self.buf = b""
        self.start()

    def start(self):
        self.proc = subprocess.Popen(
            [
                "stdbuf",
                "-oL",
                "gdbus",
                "monitor",
                "--system",
                "--dest",
                "org.freedesktop.login1",
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
        self.fd = self.proc.stdout.fileno()
        os.set_blocking(self.fd, False)
        self.buf = b""

    def lines(self):
        try:
            chunk = os.read(self.fd, 4096)
        except BlockingIOError:
            return []
        if not chunk:
            self.restart()
            return []
        self.buf += chunk
        lines = []
        while b"\n" in self.buf:
            line, self.buf = self.buf.split(b"\n", 1)
            lines.append(line.decode(errors="replace"))
        return lines

    def restart(self):
        if self.proc is not None:
            self.proc.kill()
            self.proc.wait()
        log("sleep monitor stopped; starting it again")
        self.start()


def run():
    buttons = []
    paths = {}
    buffers = {}
    denied = True
    denied_logged = False
    last_press = None
    resume_until = 0.0
    sleep = SleepWatch()

    while True:
        if denied or not buttons:
            found, denied = open_power_buttons(set(paths.values()))
            for path, fd in found:
                buttons.append(fd)
                paths[fd] = path
                buffers[fd] = b""
                log(f"watching {device_name(fd)}")
            if not buttons:
                if denied and not denied_logged:
                    log("the power button is not readable yet")
                    denied_logged = True
                time.sleep(2)
                continue
            if denied and not denied_logged:
                log("a power button is not readable yet")
                denied_logged = True

        readable, _, _ = select.select(
            buttons + [sleep.fd], [], [], 2.0 if denied else None
        )
        if not readable:
            continue
        if sleep.fd in readable:
            for line in sleep.lines():
                state = parse_sleep(line)
                if state is True:
                    resume_until = 0.0
                elif state is False:
                    resume_until = time.monotonic() + RESUME_GRACE_S
                    log("resumed; ignoring the wake press")
        for fd in list(readable):
            if fd == sleep.fd:
                continue
            try:
                chunk = os.read(fd, 1024)
            except BlockingIOError:
                continue
            except OSError as error:
                log(f"power button closed: {error}")
                os.close(fd)
                buttons.remove(fd)
                paths.pop(fd, None)
                buffers.pop(fd, None)
                continue
            if not chunk:
                os.close(fd)
                buttons.remove(fd)
                paths.pop(fd, None)
                buffers.pop(fd, None)
                continue
            blob = buffers.get(fd, b"") + chunk
            whole = len(blob) - (len(blob) % EVENT.size)
            actions = key_actions(blob[:whole])
            buffers[fd] = blob[whole:]
            for action in actions:
                if action != "power":
                    apply_volume(action)
                    continue
                now = time.monotonic()
                if not accept_press(now, last_press):
                    log("ignored repeated power key")
                    continue
                last_press = now
                chosen = decide(screen_on(), session_locked(), now < resume_until)
                if chosen == "wake":
                    log("wake")
                    wake_screen()
                elif chosen == "lock":
                    lock_screen()
                elif chosen == "sleep":
                    suspend()
                else:
                    log(f"ignored {chosen}")


def main():
    if "--self-test" in sys.argv:
        self_test()
        return
    if len(sys.argv) == 3 and sys.argv[1] == "--volume":
        apply_volume(sys.argv[2])
        return
    run()


if __name__ == "__main__":
    main()
